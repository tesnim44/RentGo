DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin

# Compte administrateur de développement. À remplacer avant déploiement.
DEMO_ADMIN_PHONE=+21620123456
DEMO_ADMIN_PASSWORD=RentGoAdmin2026!
DEMO_ADMIN_EMAIL=admin@rentgo.tn
DB_NAME=your_db_name
JWT_SECRET=change_this_secret

# postgres = use PostgreSQL and fallback to memory if unavailable.
# memory = force local in-memory data for frontend development.
DB_MODE=postgres

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15017122661

# auto = Twilio if configured, otherwise print OTP in backend console.
# twilio = require a real Twilio SMS configuration and fail if it is missing.
OTP_DELIVERY_MODE=auto

# Email delivery for OTPs and password-reset links. Both MAIL_* and the
# older SMTP_* names are supported; use one naming scheme consistently.
# When no credentials are configured, password-reset links are logged to the
# backend console in development.
WEB_APP_URL=http://localhost:5111
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@rentgo.tn
